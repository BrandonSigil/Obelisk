<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What Xcode adds to the Info.plist it generates. Sparkle reads the latest release's appcast.xml, which
     .github/workflows/appcast.yml signs with the private key of SUPublicEDKey. Obelisk checks once a day without
     asking first, and installs a new version when it quits until the player turns that off in Settings. -->
<plist version="1.0">
<dict>
	<key>SUFeedURL</key>
	<string>https://github.com/BrandonSigil/Obelisk/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>onA1JCi/XyexUD2t4elc/SB8PPw6pna77U9Wj7H39EU=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
</dict>
</plist>
